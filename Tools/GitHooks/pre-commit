#!/bin/sh
# ProjectTP 커밋 전 검사
# 설치: sh Tools/GitHooks/install-hooks.sh
# 비상시에만 건너뛰기: git commit --no-verify

MAX_BIN_BYTES=1048576  # LFS가 아닌 바이너리 허용 크기 (1MB)

fail=0
err() { echo "[pre-commit] $*" >&2; fail=1; }

list=$(mktemp) || exit 1
trap 'rm -f "$list"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' > "$list"

while IFS= read -r f; do
	[ -n "$f" ] || continue

	# 1. 외부 에셋·개인 폴더는 커밋하지 않는다 (git add -f 방지)
	case "$f" in
		Content/ThirdParty/*|Content/Developers/*)
			err "외부/개인 에셋은 커밋할 수 없습니다: $f"
			continue ;;
	esac

	size=$(git cat-file -s ":$f")

	# 2. LFS 대상은 포인터로 스테이징돼야 한다 (LFS 미설치면 원본이 그대로 들어간다)
	if [ "$(git check-attr filter -- "$f" | sed 's/.*: //')" = "lfs" ]; then
		if [ "$size" -gt 1024 ] || ! git cat-file -p ":$f" | head -n 1 | grep -q '^version https://git-lfs'; then
			err "LFS 포인터가 아닙니다 (git lfs install 확인): $f"
		fi
		continue
	fi

	# 3. LFS가 아닌 큰 바이너리는 막는다
	if [ "$size" -gt "$MAX_BIN_BYTES" ] && [ "$(git diff --cached --numstat -- "$f" | cut -f1)" = "-" ]; then
		err "LFS가 아닌 바이너리가 너무 큽니다 (${size} bytes): $f → .gitattributes에 LFS 패턴 추가"
	fi

	# 4. 수치 CSV: 열 개수와 행 이름 검사
	case "$f" in
		Data/*.csv)
			git show ":$f" | awk -v file="$f" '
				function count(line,   i, c, n, q) {
					n = 1; q = 0
					for (i = 1; i <= length(line); i++) {
						c = substr(line, i, 1)
						if (c == "\"") q = !q
						else if (c == "," && !q) n++
					}
					return n
				}
				{ sub(/\r$/, "") }
				NR == 1 { cols = count($0); next }
				/^[ \t]*$/ { next }
				{
					n = count($0)
					if (n != cols) {
						printf "[pre-commit] %s:%d 열 개수 %d, 헤더는 %d\n", file, NR, n, cols > "/dev/stderr"; bad = 1
					}
					name = $0; sub(/,.*/, "", name); gsub(/"/, "", name)
					if (name == "") {
						printf "[pre-commit] %s:%d 행 이름이 비었습니다\n", file, NR > "/dev/stderr"; bad = 1
					} else if (name in seen) {
						printf "[pre-commit] %s:%d 행 이름 중복: %s (%d행과 같음)\n", file, NR, name, seen[name] > "/dev/stderr"; bad = 1
					}
					seen[name] = NR
				}
				END {
					if (NR == 0) { printf "[pre-commit] %s 파일이 비었습니다\n", file > "/dev/stderr"; bad = 1 }
					exit bad
				}
			' || fail=1 ;;
	esac
done < "$list"

if [ "$fail" -ne 0 ]; then
	echo "[pre-commit] 위 문제로 커밋을 중단했습니다." >&2
	exit 1
fi
